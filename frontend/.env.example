# Frontend environment (Vite). Copy to .env and adjust.
#   cp .env.example .env
# VITE_* values are baked in at build time: restart `npm run dev` or rebuild after changing them.

# Branding (page title, topbar, footer, login, error codes)
VITE_APP_NAME="ICT Schedule System"
VITE_APP_SHORT_NAME="ISCHED"
VITE_ORG_NAME="Department of Health - Ilocos Center for Health Development"
VITE_ORG_SHORT_NAME="DOH-ICHD"
VITE_APP_LOGO="/layout/img/dohlogo.png"

# API base URL. Default "/api" works with the dev proxy and when the built app is served
# from the same origin as the API. Only set this if the API lives elsewhere.
# VITE_API_BASE_URL="/api"
