#--------------------------------------------------------------------
# Backend environment (CodeIgniter 4). Copy to .env and adjust.
#   cp .env.example .env
# Never commit .env.
#--------------------------------------------------------------------

# development | production. Production hides error details: always use it when deployed.
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Must be HTTPS: session and CSRF cookies are marked Secure.
app.baseURL = 'https://sakai.dev.local/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = sakai_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate with: php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# FRONTEND / CORS
#--------------------------------------------------------------------
# Public URL of the frontend. Used for password-reset links and as the
# default CORS origin.
FRONTEND_URL = "https://sakai.dev.local:4747"

# Optional: comma-separated CORS origins (defaults to FRONTEND_URL).
# Not needed when the frontend is served from the same origin as the API.
# CORS_ALLOWED_ORIGINS = "https://app.example.com,https://admin.example.com"

#--------------------------------------------------------------------
# PASSWORD RESET
#--------------------------------------------------------------------
PASSWORD_RESET_EXPIRE_MINUTES = 30

#--------------------------------------------------------------------
# EMAIL (SMTP)
#--------------------------------------------------------------------
email.fromEmail = noreply@example.com
email.SMTPHost = smtp.gmail.com
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPUser =
email.SMTPPass =

#--------------------------------------------------------------------
# BRANDING (names used in emails; see app/Config/Branding.php)
#--------------------------------------------------------------------
branding.appName      = 'ICT Schedule System'
branding.appShortName = 'ISCHED'
branding.orgName      = 'Department of Health - Ilocos Center for Health Development'
branding.orgShortName = 'DOH-ICHD'
